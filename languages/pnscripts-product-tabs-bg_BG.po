#. Plugin Name of the plugin
#: pnscripts-product-tabs.php
msgid "PN Product Tabs – Custom Tabs & FAQ"
msgstr "PN Product Tabs – Custom Tabs & FAQ"

#. Plugin URI of the plugin
#: pnscripts-product-tabs.php
msgid "https://pnscripts.com/marketplace/pn-product-tabs"
msgstr "https://pnscripts.com/marketplace/pn-product-tabs"

#. Description of the plugin
#: pnscripts-product-tabs.php
msgid "Custom product tabs per product, reusable global tabs by category or tag, FAQ tabs with optional FAQPage schema, rename, reorder or hide the default tabs, and a one-click importer from YIKES Custom Product Tabs. Works in classic and block themes."
msgstr "Собствени раздели за всеки продукт, глобални раздели за категории или етикети, раздели с ЧЗВ и FAQPage schema, преименуване, подреждане и скриване на стандартните раздели и импорт с едно кликване от YIKES Custom Product Tabs. Работи с класически и блокови теми."

#. Author of the plugin
#: pnscripts-product-tabs.php
msgid "PN Scripts"
msgstr "PN Scripts"

#. Author URI of the plugin
#: pnscripts-product-tabs.php
msgid "https://pnscripts.com"
msgstr "https://pnscripts.com"

