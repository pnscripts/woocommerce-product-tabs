#. Plugin Name of the plugin
#: pnscripts-product-tabs.php
msgid "PN Scripts Product Tabs – Custom Tabs & FAQ"
msgstr "PN Scripts Product Tabs – Custom Tabs & FAQ"

#. Plugin URI of the plugin
#: pnscripts-product-tabs.php
msgid "https://pnscripts.com/marketplace/pn-product-tabs"
msgstr "https://pnscripts.com/marketplace/pn-product-tabs"

#. Description of the plugin
#: pnscripts-product-tabs.php
msgid "Custom product tabs per product, reusable global tabs by category or tag, FAQ tabs with optional FAQPage schema, rename, reorder or hide the default tabs, and a one-click importer from YIKES Custom Product Tabs. Works in classic and block themes."
msgstr "Własne zakładki dla każdego produktu, globalne zakładki według kategorii lub tagów, zakładki FAQ z opcjonalnym schematem FAQPage, zmiana nazwy, kolejności lub ukrywanie domyślnych zakładek oraz import jednym kliknięciem z YIKES Custom Product Tabs. Działa z motywami klasycznymi i blokowymi."

#. Author of the plugin
#: pnscripts-product-tabs.php
msgid "PN Scripts"
msgstr "PN Scripts"

#. Author URI of the plugin
