<?xml version="1.0"?>
<ruleset name="PN Product Tabs">
	<description>WordPress Coding Standards 3 for PN Product Tabs for WooCommerce.</description>

	<file>pnscripts-product-tabs.php</file>
	<file>uninstall.php</file>
	<file>src</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress">
		<!-- PSR-4 class files (src/Admin/ProductPanel.php) instead of class-*.php. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Short array syntax is not used; long syntax is enforced by WPCS. Typed PHP 8.1 code. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>
		<!-- Docblocks use PHPStan array shapes and type aliases; PHPStan level 8 checks the types. -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="pnscripts-product-tabs"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_products"/>
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="pnscripts_product_tabs"/>
				<element value="Pnscripts\ProductTabs"/>
				<element value="PNSCRIPTS_PRODUCT_TABS"/>
			</property>
		</properties>
	</rule>
</ruleset>
